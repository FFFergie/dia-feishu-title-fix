{
  "manifest_version": 3,
  "name": "Dia Feishu Title Fix",
  "version": "1.1.0",
  "description": "Fix Feishu document titles in Dia and close all Feishu tabs on demand.",
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/base/*",
        "https://*.feishu.cn/docx/*",
        "https://*.feishu.cn/docs/*",
        "https://*.feishu.cn/wiki/*",
        "https://*.feishu.cn/sheets/*",
        "https://*.feishu.cn/slides/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Dia Feishu Title Fix",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.feishu.link/*",
    "https://*.feishuapp.com/*",
    "https://*.larkoffice.com/*",
    "https://*.larksuite.com/*"
  ]
}
