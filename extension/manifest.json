{
  "manifest_version": 3,
  "name": "Dia Feishu Title Fix",
  "version": "1.0.0",
  "description": "Restore readable Feishu document titles in Dia browser tabs by removing invisible formatting prefixes.",
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/base/*",
        "https://*.feishu.cn/docx/*",
        "https://*.feishu.cn/docs/*",
        "https://*.feishu.cn/wiki/*",
        "https://*.feishu.cn/sheets/*",
        "https://*.feishu.cn/slides/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
